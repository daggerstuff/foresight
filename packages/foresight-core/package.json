{
  "name": "@foresight/core",
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "description": "TypeScript SDK for Foresight Memory Architecture",
  "keywords": [
    "ai",
    "foresight",
    "mcp",
    "memory"
  ],
  "license": "MIT",
  "author": "Foresight Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "zod": ">=3.22.0 <5"
  }
}
