# ─────────────────────────────────────────────────────────────────
# Foresight environment configuration
# Copy to .env and fill in values, or let install.sh generate it.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────
# PostgreSQL connection string. Neon, Supabase, Railway, or any
# managed Postgres works. SQLite is NOT supported.
FORESIGHT_DB_URL=postgresql://user:password@host:5432/foresight?sslmode=require

# ── IDENTITY (optional) ────────────────────────────────────────
# Format: "user" or "user@account". Defaults to $USER@default.
# FORESIGHT_IDENTITY=vivi@pixelated

# Memory bank isolation. Defaults to "default".
# FORESIGHT_BANK_ID=default

# ── LLM (optional — for synthesis, reflection, curation) ──────
# If unset, LLM-dependent features degrade gracefully (no synthesis,
# no reflection, no curation LLM calls). The system still works for
# basic memory store/search/inject.
# FORESIGHT_LLM_PROVIDER=openai
# FORESIGHT_LLM_API_KEY=your-api-key
# FORESIGHT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# FORESIGHT_LLM_MODEL=minimaxai/minimax-m3

# ── Redis (optional — companion cache) ─────────────────────────
# If unset, falls back to in-process dict cache. Redis improves
# multi-process scenarios but is not required for single-user setups.
# FORESIGHT_REDIS_URL=redis://:password@127.0.0.1:6379/0

# ── Server transport ───────────────────────────────────────────
# HTTP transport (Streamable HTTP) for MCP clients that need
# network access (OpenCode, remote agents). Default: stdio.
# FORESIGHT_ENABLE_WS=1

# Local dev only — disables auth checks. Do NOT use in production.
# FORESIGHT_ALLOW_UNAUTHENTICATED=1

# ── Background daemons (optional) ───────────────────────────────
# Decay sweep interval (hours). Default: 6.
# FORESIGHT_DECAY_INTERVAL_HOURS=6

# Maintenance + GC interval (hours). Default: 24.
# Runs consolidate, archive_stale, synthesize, prune_low_relevance,
# then GC expired ephemeral/short_term memories.
# FORESIGHT_MAINTENANCE_INTERVAL_HOURS=24

# ── Rate limiting (optional) ───────────────────────────────────
# FORESIGHT_LLM_RATE_LIMIT=60
# FORESIGHT_LLM_BURST_LIMIT=10
# FORESIGHT_LLM_MIN_INTERVAL=0.5
# FORESIGHT_LLM_MAX_PROMPT_CHARS=10000
